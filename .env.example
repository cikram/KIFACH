# Copy to .env to run KIFACH against a real model.
# With none of these set, KIFACH runs the offline mock provider and labels
# every result MOCK.

# --- NVIDIA NIM ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
KIFACH_VLM_MODEL=nvidia/cosmos-reason2-8b

# --- or any OpenAI-compatible vision endpoint ---
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=

# --- overrides ---
# KIFACH_PROVIDER=mock        # nvidia | openai_compat | mock
# KIFACH_CACHE=on             # on | off | replay (replay never calls the network)
# KIFACH_FPS=2.0
# KIFACH_WINDOW_SECONDS=4.0
# KIFACH_MIN_CONFIDENCE=0.6
